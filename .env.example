# 複製成 .env 後填入（.env 不要進 git）
# 建議在 Binance 建立「只讀」API Key，並將白名單 IP 設為這台機器的固定 IP
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TIMEOUT=10

# 網站登入的「初始」密碼：只在第一次啟動（尚無 /data/auth.json）時使用，
# 之後請登入網站按「修改密碼」更改；改過後這裡的值就不再有作用
ADMIN_PASSWORD=
# 有 HTTPS 時改成 1，cookie 只走 HTTPS
SESSION_COOKIE_SECURE=0

# 對外 HTTP port
HTTP_PORT=80
